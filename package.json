{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-server-connection.mjs",
    "lint": "oxlint src server api --config _oxlintrc.json",
    "test": "node --test",
    "test:integration": "npx --yes --package firebase-tools@15.34.0 firebase emulators:exec --only firestore,auth --project demo-oyun-portali --config firebase.emulator.json \"node --test server/firestore.integration.test.js\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google-cloud/firestore": "9.3.1",
    "@vercel/oidc": "4.0.2",
    "firebase": "^10.12.0",
    "firebase-admin": "14.5.0",
    "google-auth-library": "11.3.1",
    "lucide-react": "^0.378.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.17",
    "oxlint": "^1.69.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.6"
  }
