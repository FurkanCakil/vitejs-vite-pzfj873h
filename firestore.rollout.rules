// Staged rollout: retain existing access for games awaiting migration.
// V2 rooms, private player views and bounded lobbies are server-written only.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /artifacts/{appId}/public/data/rooms/{roomId} {
      allow read, create: if true;
      allow update: if request.auth != null;
    }
    match /artifacts/{appId}/public/data/serverStatus/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /artifacts/{appId}/public/data/presenceV2/{shardId} {
      allow get, list: if request.auth != null;
      allow write: if false;
    }
    match /artifacts/{appId}/public/data/roomsV2/{roomId} {
      allow get: if request.auth != null
        && (request.auth.uid in resource.data.players || request.auth.uid in resource.data.spectators);
      allow list, write: if false;
    }
    match /artifacts/{appId}/public/data/xoxLobby/queue {
      allow get: if request.auth != null;
      allow list, write: if false;
    }
    match /artifacts/{appId}/public/data/connect4Lobby/queue {
      allow get: if request.auth != null;
      allow list, write: if false;
    }
    match /artifacts/{appId}/public/data/checkersLobby/queue {
      allow get: if request.auth != null;
      allow list, write: if false;
    }
    match /artifacts/{appId}/public/data/okeyLobby/queue {
      allow get: if request.auth != null;
      allow list, write: if false;
    }
    match /artifacts/{appId}/public/data/battleshipLobby/queue {
      allow get: if request.auth != null;
      allow list, write: if false;
    }
    match /artifacts/{appId}/public/data/roomsV2/{roomId}/playerData/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid
        && request.auth.uid in get(/databases/$(database)/documents/artifacts/$(appId)/public/data/roomsV2/$(roomId)).data.players;
      allow list, write: if false;
    }
  }
}
