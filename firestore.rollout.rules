// Staged rollout: retain existing access for games awaiting migration.
// XOX V2 and its bounded lobby are written only by the server.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /artifacts/{appId}/public/data/rooms/{roomId} {
      allow read, create: if true;
      allow update: if request.auth != null;
    }
    match /artifacts/{appId}/public/data/serverStatus/{docId} {
      allow read, write: if request.auth != null;
    }
    match /artifacts/{appId}/public/data/roomsV2/{roomId} {
      allow get: if request.auth != null
        && (request.auth.uid in resource.data.players || request.auth.uid in resource.data.spectators);
      allow list, write: if false;
    }
    match /artifacts/{appId}/public/data/xoxLobby/queue {
      allow get: if request.auth != null;
      allow list, write: if false;
    }
  }
}
